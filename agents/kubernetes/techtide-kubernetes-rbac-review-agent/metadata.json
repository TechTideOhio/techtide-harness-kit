  "summary": "Agent for techtide-kubernetes-rbac-review. Review Kubernetes Roles, ClusterRoles, RoleBindings, ClusterRoleBindings, and ServiceAccounts for least-privilege, namespace-scope minimization, and workload identity safety.",
  "source_type": "original",
  "official_docs": [
    "https://kubernetes.io/docs/reference/access-authn-authz/rbac/",
