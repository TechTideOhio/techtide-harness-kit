{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Metadata",
  "type": "object",
  "required": [
    "id",
    "name",
    "version",
    "type",
    "provider",
    "harnesses",
    "summary",
    "source_type",
    "official_docs",
    "security_notes",
    "last_verified",
    "path"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "type": {
      "const": "skill"
    },
    "provider": {
      "enum": [
        "aws",
        "azure",
        "oracle",
        "oci",
        "gcp",
        "kubernetes",
        "terraform",
        "multi-cloud",
        "generic"
        ,"claude"
        ,"codex"
        ,"gemini"
        ,"cursor"
        ,"kiro"
        ,"lovable"
        ,"replit"
        ,"v0"
        ,"vercel"
        ,"opencode"
        ,"kilo"
        ,"marketing"
        ,"techtide"
      ]
    },
    "harnesses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "codex",
          "copilot",
          "claude-code",
          "cursor",
          "gemini",
          "kiro",
          "other"
        ]
      }
    },
    "summary": {
      "type": "string",
      "minLength": 20
    },
    "source_type": {
      "enum": [
        "original",
        "adapted",
        "reference-only"
      ]
    },
    "official_docs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "format": "uri"
      }
    },
    "security_notes": {
      "type": "string",
      "minLength": 20
    },
    "last_verified": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "path": {
      "type": "string",
      "minLength": 1
    },
    "risk_tier": {
      "enum": ["L0", "L1", "L2", "L3"],
      "description": "Enterprise trust tier. L0 is inert/docs-only; L3 can influence production, credentials, spend, or external effects and requires explicit gates."
    },
    "data_classes": {
      "type": "array",
      "description": "Data classes the skill may handle when used as intended.",
      "items": { "type": "string", "minLength": 1 }
    },
    "tool_permissions": {
      "type": "object",
      "description": "Machine-readable permission summary for filesystem, shell, network, secrets, and external tools.",
      "additionalProperties": true
    },
    "network_egress": {
      "type": "object",
      "description": "Default network posture and explicitly allowed egress conditions.",
      "additionalProperties": true
    },
    "approval_gates": {
      "type": "array",
      "description": "Human approval gates required before risky operations.",
      "items": { "type": "string", "minLength": 1 }
    },
    "agent_identity_mode": {
      "enum": ["none", "delegated-user", "service-account", "delegated-user-or-repo-assistant"],
      "description": "Identity mode expected when the skill is executed by an agent."
    },
    "audit_events": {
      "type": "array",
      "description": "Recommended audit event names emitted or recorded by compatible runtimes.",
      "items": { "type": "string", "minLength": 1 }
    },
    "control_mappings": {
      "type": "array",
      "description": "Control family identifiers supported by this skill's guardrails.",
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence_links": {
      "type": "array",
      "description": "Local or URL evidence links for trust, eval, or source posture.",
      "items": { "type": "string", "minLength": 1 }
    }
  },
  "additionalProperties": true
}
