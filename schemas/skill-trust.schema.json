{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Skill Trust Manifest",
  "type": "object",
  "required": ["manifest_version", "generated_by", "generated_at", "owner", "policy", "counts", "skills"],
  "properties": {
    "manifest_version": { "type": "integer", "minimum": 1 },
    "generated_by": { "type": "string", "minLength": 1 },
    "generated_at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "owner": { "type": "string", "minLength": 1 },
    "policy": { "type": "object" },
    "counts": { "type": "object" },
    "skills": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "risk_tier",
          "data_classes",
          "tool_permissions",
          "network_egress",
          "approval_gates",
          "agent_identity_mode",
          "audit_events",
          "control_mappings",
          "evidence_links",
          "source_evidence"
        ],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$" },
          "risk_tier": { "enum": ["L0", "L1", "L2", "L3"] },
          "data_classes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "tool_permissions": { "type": "object" },
          "network_egress": { "type": "object" },
          "approval_gates": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "agent_identity_mode": { "type": "string" },
          "audit_events": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "control_mappings": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "evidence_links": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "source_evidence": { "type": "object" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
